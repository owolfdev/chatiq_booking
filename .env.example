# Service-to-service auth: ChatIQ adapter sends this as Bearer token
BOOKING_SERVICE_TOKEN=dev-booking-service-token-change-me

# Optional: allow unauthenticated health checks in local dev (default: open)
# BOOKING_HEALTH_OPEN=1

# Booking Supabase (dedicated project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: admin copilot NL → propose (falls back to heuristics if unset)
# BOOKING_COPILOT_OPENAI_KEY=sk-...
# OPENAI_API_KEY=sk-...
# BOOKING_COPILOT_MODEL=gpt-4o-mini

# Consent / connect URL base (ChatIQ-hosted page)
# BOOKING_CONNECT_URL_BASE=https://www.chatiq.io/booking/connect

# Cron keepalive
# CRON_SECRET=...
